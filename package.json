{
  "name": "field-inspections",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first safety inspection app: a worked example of correct device-to-server sync.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0 <23.0.0"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/check-static-routes.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:server": "vitest run --project server",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "node --conditions=react-server node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --conditions=react-server node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --conditions=react-server node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "client-only": "^0.0.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.55",
    "@electric-sql/pglite": "^0.5.16",
    "@next/env": "16.4.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.10.2",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
