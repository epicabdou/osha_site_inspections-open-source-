# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, set these in Project Settings → Environment Variables
# (the Neon and Blob integrations add DATABASE_URL and BLOB_READ_WRITE_TOKEN for you).

# --- Clerk (https://dashboard.clerk.com → your app → API keys) -----------------
# Publishable key: safe to expose, inlined into the browser bundle at build time.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret key: server only. Used by clerkMiddleware(), auth() and the e2e test helpers.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Postgres (Neon via the Vercel Marketplace, or any Postgres 15+) ------------
# Use the pooled connection string. Needed by the API routes, the dashboard,
# `pnpm db:migrate` and `pnpm db:seed`; `next build` does not need it.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Optional: direct (unpooled) connection, preferred by `pnpm db:migrate` for DDL.
# The Neon integration on Vercel sets it automatically; locally it can be omitted.
# DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require

# --- Vercel Blob (Vercel → Storage → Blob) -------------------------------------
# Server only. Issues client-upload tokens so photos go straight from the
# device to Blob storage without passing through a function. Used from M3.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# --- Demo ----------------------------------------------------------------------
# "true" shows the chaos panel to everyone (used on the public demo).
# Otherwise it appears only with ?demo=1 in the URL. Inlined at build time.
NEXT_PUBLIC_DEMO_MODE=false

# --- End-to-end tests only (not read by the app) -------------------------------
# Email addresses of the two Clerk test users (see README, "Test users").
# Playwright signs them in with Clerk testing tokens; no passwords are needed.
E2E_INSPECTOR_EMAIL=inspector+clerk_test@example.com
E2E_SUPERVISOR_EMAIL=supervisor+clerk_test@example.com
